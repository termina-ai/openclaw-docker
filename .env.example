# OpenClaw Docker Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Model provider API keys (set the one(s) you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Gateway auth token (required - secures access to the dashboard and API)
# Generate something random, e.g.: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Default model — use an agentic model for best results
# If using Anthropic: anthropic/claude-opus-4-6
# If using OpenAI:    openai/gpt-5.3-codex
OPENCLAW_MODEL=anthropic/claude-opus-4-6

# APPLICATION KEYS
AIRTABLE_API_TOKEN=
ELEVENLABS_API_KEY=
