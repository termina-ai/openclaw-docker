# OpenClaw Docker Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Model provider API keys (set the one(s) you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Gateway auth token (required - secures access to the dashboard and API)
# Generate something random, e.g.: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=__GENERATED_BY_MAKE_INIT__

# Default model per provider — used when auto-detecting from available API keys.
# The entrypoint picks the first provider with a key set.
ANTHROPIC_DEFAULT_MODEL=anthropic/claude-opus-4-6
OPENAI_DEFAULT_MODEL=openai/gpt-5.2

# Explicit override — if set, this is used regardless of which keys are present.
# Leave blank to auto-detect from the provider defaults above.
OPENCLAW_MODEL=

# Default thinking/reasoning level for all models that support it.
# Options: off | minimal | low | medium | high | xhigh | adaptive
OPENCLAW_THINKING_DEFAULT=adaptive

# APPLICATION KEYS
AIRTABLE_API_TOKEN=
ELEVENLABS_API_KEY=
